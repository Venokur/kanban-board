# PostgreSQL
POSTGRES_DB=kanban
POSTGRES_USER=kanban
POSTGRES_PASSWORD=kanban
POSTGRES_PORT=5432

# Application
APP_PORT=9501
APP_DEBUG=0

# Coroutine runtime: openswoole (default) | swoole
# The image is built with OpenSwoole; switch only together with the matching
# extension build (backend/Dockerfile).
SWOOLE_VARIANT=openswoole

# CSRF token signing secret. Change in production.
APP_SECRET=change-me-please

# Serve over HTTPS: sets the Secure flag on the session cookie.
APP_HTTPS=0

# Compatibility switches (both off by default)
# APP_LEGACY_TOKEN: also return the raw session token from login/register
#   (needed by non-browser clients such as curl scripts).
# APP_WS_QUERY_TOKEN: accept /ws?token=… when the cookie is unavailable
#   (the token then ends up in proxy access logs).
APP_LEGACY_TOKEN=0
APP_WS_QUERY_TOKEN=0

# Frontend (dev)
DEV_PORT=5173
