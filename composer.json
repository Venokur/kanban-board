{
    "name": "kanban/board",
    "description": "Kanban board on OpenSwoole: PHP backend tooling (no runtime dependencies).",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "ext-openswoole": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "backend/src/"
        }
    },
    "scripts": {
        "lint": "php-cs-fixer fix --dry-run --diff",
        "lint:fix": "php-cs-fixer fix",
        "stan": "phpstan analyse --no-progress",
        "check": [
            "@lint",
            "@stan"
        ]
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.3.0",
            "ext-openswoole": "26.2.0"
        }
    }
}
