<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="backend/tests/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnWarning="true"
         failOnRisky="true">
    <testsuites>
        <testsuite name="unit">
            <directory>backend/tests/Unit</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>backend/src</directory>
        </include>
        <exclude>
            <file>backend/src/rt.php</file>
            <file>backend/src/autoload.php</file>
            <file>backend/src/migrate.php</file>
        </exclude>
    </source>
</phpunit>
